#!/usr/bin/env bash
set -euo pipefail

# jj-cherry-pick [commit-hash]
#
# Logic:
# - makes new commit with same change (like cherry-pick commit object)
# - inserts it after current parent (@-)
# - rebases working-copy commit (@) on top, so your working copy “moves forward” like git cherry-pick.

commit_hash="${1:-}"

echo "Like a git cherry-pick: will copy the given commit and insert it as a new parent commit under working copy."
echo "Want to just apply the commit content into working commit? use 'jj-apply-commit' instead."

if [ -z "$commit_hash" ]; then
  read -rp "Enter commit hash to cherry-pick: " commit_hash
fi

if [ -z "$commit_hash" ]; then
  echo "Error: commit hash required." >&2
  exit 1
fi

jj duplicate --insert-after @- "$commit_hash"
