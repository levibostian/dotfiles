#!/usr/bin/env -S deno run --allow-run --allow-read --allow-env

// work <github-pull-url>
//
// Navigate to the branch of a GitHub PR and switch to it.
//
//   1. Parse owner/repo + PR number from the URL.
//   2. Get the PR head branch via `gh`.
//   3. Look up the local repo root in ~/.binnys/.work.json (JSON map
//      of "owner/repo" -> absolute path). Exits if no entry. Falls back to a
//      bare "repo" key if there's no owner/repo key.
//   4. If that branch is checked out in any worktree, cd there; otherwise
//      git-checkout it in the mapped dir (fetching first if needed).
//   5. If a mise "work" task exists in the target dir, run "mise task work".
//   6. Print the final directory so a shell wrapper can `cd` into it:
//
//        work() { local d; d="$(command work "$@")" && cd -- "$d"; }
//
//   (a standalone executable cannot change the parent shell's cwd — the
//    wrapper above is what makes the cd actually stick.)

const PR_URL_RE = /github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/;

const decoder = new TextDecoder();

interface CmdResult {
  code: number;
  stdout: string;
  stderr: string;
}

// Run a command, capturing output (never passes through).
function cap(args: string[], cwd?: string): CmdResult {
  const out = new Deno.Command(args[0], {
    args: args.slice(1),
    cwd,
    stdout: "piped",
    stderr: "piped",
  }).outputSync();
  return { code: out.code, stdout: decoder.decode(out.stdout), stderr: decoder.decode(out.stderr) };
}

// Run a command for the user, returning its exit code. Everything the command
// prints is routed to our stderr so stdout stays reserved for the final
// printed directory (a shell wrapper captures that as the cd target).
function show(args: string[], cwd?: string): number {
  const out = new Deno.Command(args[0], {
    args: args.slice(1),
    cwd,
    stdout: "piped",
    stderr: "piped",
  }).outputSync();
  if (out.stdout.byteLength > 0) Deno.stderr.writeSync(out.stdout);
  if (out.stderr.byteLength > 0) Deno.stderr.writeSync(out.stderr);
  return out.code;
}

function fail(msg: string): never {
  console.error(`work: ${msg}`);
  Deno.exit(1);
}

function expandHome(p: string): string {
  return p.startsWith("~/") ? `${Deno.env.get("HOME")}/${p.slice(2)}` : p;
}

// Split `git worktree list --porcelain` into per-worktree blocks and return
// the path of the worktree whose branch matches, or null.
function findWorktreeBranch(root: string, headBranch: string): string | null {
  const wt = cap(["git", "-C", root, "worktree", "list", "--porcelain"]);
  if (wt.code !== 0) return null;
  for (const block of wt.stdout.split(/\n\s*\n/)) {
    if (!block.includes(`branch refs/heads/${headBranch}`)) continue;
    return block.match(/^worktree (.+)$/m)?.[1] ?? null;
  }
  return null;
}

function selftest(): void {
  const url = "https://github.com/acme/widgets/pull/42?foo=bar";
  const m = url.match(PR_URL_RE)!;
  console.assert(m?.[1] === "acme" && m?.[2] === "widgets" && m?.[3] === "42", "pr url parse");
  console.assert("https://github.com/a/b/pull/1".match(PR_URL_RE) !== null, "bare url");
  console.assert("https://github.com/a/b/commit/1".match(PR_URL_RE) === null, "non-pr url rejected");
  console.assert(expandHome("~/x") === `${Deno.env.get("HOME")}/x`, "home expansion");
  console.log("work: selftest ok");
  Deno.exit(0);
}

if (Deno.args[0] === "--selftest") selftest();

const [url] = Deno.args;
if (!url) fail("usage: work <github-pull-url>  (--selftest to self-check)");

const m = url.match(PR_URL_RE);
if (!m) fail(`could not parse GitHub PR URL: ${url}`);
const [, owner, repo, prNum] = m;
const repoKey = `${owner}/${repo}`;

const pr = cap(["gh", "pr", "view", prNum, "--repo", repoKey, "--json", "headRefName", "--jq", ".headRefName"]);
if (pr.code !== 0) fail(`gh pr view failed: ${pr.stderr.trim() || "(is gh installed/authed?)"}`);
const headBranch = pr.stdout.trim();
if (!headBranch) fail("gh returned an empty head branch");
console.error(`work: ${repoKey}#${prNum} @ ${headBranch}`);

const configPath = `${Deno.env.get("HOME")}/.binnys/.work.json`;
let config: Record<string, string>;
try {
  config = JSON.parse(await Deno.readTextFile(configPath));
} catch (e) {
  fail(`could not read ${configPath}: ${(e as Error).message}`);
}
const rawDir = config[repoKey] ?? config[repo] ?? null;
if (!rawDir) fail(`no entry for '${repoKey}' (or '${repo}') in ${configPath}`);
const workDir = expandHome(rawDir);

// Prefer an existing worktree on this branch; otherwise checkout in the map dir.
let finalDir = findWorktreeBranch(workDir, headBranch) ?? workDir;
if (finalDir === workDir) {
  let code = show(["git", "-C", workDir, "checkout", headBranch]);
  if (code !== 0) {
    // Branch not local yet — fetch it from origin, then retry.
    if (show(["git", "-C", workDir, "fetch", "origin", headBranch]) !== 0) {
      fail(`could not fetch branch '${headBranch}' (remote is 'origin')`);
    }
    code = show(["git", "-C", workDir, "checkout", headBranch]);
    if (code !== 0) fail(`checkout of '${headBranch}' failed`);
  }
}

// Run the optional mise "work" task, if defined in the target dir.
const tasks = cap(["mise", "-C", finalDir, "tasks", "--json"]);
if (tasks.code === 0) {
  const names = (JSON.parse(tasks.stdout) as { name: string }[]).map((t) => t.name);
  if (names.includes("work")) {
    if (show(["mise", "-C", finalDir, "run", "work"]) !== 0) {
      console.error("work: mise 'work' task failed (continuing)");
    }
  }
}

console.log(finalDir);